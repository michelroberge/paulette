# Copy this file to .env and fill in values as needed.
# The .env file is gitignored — never commit secrets.

# Optional: Anthropic API key, used if not authenticated via OAuth in the app.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the port paulette listens on (default: 8080)
# PORT=8080

# Optional: override where generated project repos are stored on the host.
# Defaults to ~/repos.
# REPOS_PATH=/home/yourname/repos
