# Dev image: mounts source from host, uses air for Go hot reload.
# Build: make dev-docker-build
# Run:   make dev-docker-up
FROM golang:1.26-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    # Node 22
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    # Dolt — version-controlled issue tracking (used by beads)
    && curl -L https://github.com/dolthub/dolt/releases/latest/download/install.sh | bash \
    # Claude Code CLI
    && npm install -g @anthropic-ai/claude-code \
    # beads (bd) issue tracker
    && (npm install -g @beads/bd 2>/dev/null || curl -fsSL https://raw.githubusercontent.com/steveyegge/beads/main/scripts/install.sh | bash) \
    && bd --version \
    # air — Go live-reload tool
    && go install github.com/air-verse/air@latest \
    # repos dir + Claude Code permissions for non-interactive agent use
    && mkdir -p /root/repos /root/.claude \
    && printf '%s' \
         '{"permissions":{"allow":[' \
         '"Write(/root/repos/**)",' \
         '"Edit(/root/repos/**)",' \
         '"Bash(*)",' \
         '"Read(/root/repos/**)"' \
         ']}}' \
         > /root/.claude/settings.json

WORKDIR /workspace

ENV HOME=/root \
    REGISTRY_PATH=/root/.paulette \
    REPOS_PATH=/root/repos \
    CLAUDE_PATH=claude \
    PORT=8080

EXPOSE 8080 5173
