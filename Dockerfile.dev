# Dev image: mounts source from host, uses air for Go hot reload.
# Build: make dev-docker-build
# Run:   make dev-docker-up
FROM golang:1.26-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Node 22
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# air — Go live-reload tool
RUN go install github.com/air-verse/air@latest

# Dolt — version-controlled issue tracking (used by beads)
RUN curl -L https://github.com/dolthub/dolt/releases/latest/download/install.sh | bash

# Claude Code CLI
RUN npm install -g @anthropic-ai/claude-code

# beads (bd) issue tracker
RUN npm install -g @beads/bd 2>/dev/null || \
    curl -fsSL https://raw.githubusercontent.com/steveyegge/beads/main/scripts/install.sh | bash
RUN bd --version

WORKDIR /workspace

ENV HOME=/root \
    REGISTRY_PATH=/root/.paulette \
    REPOS_PATH=/root/repos \
    CLAUDE_PATH=claude \
    PORT=8080

EXPOSE 8080 5173
